# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 大文件不进 Git（原始数据可重新下载/生成）
data/raw/
*.sdf
*.zip

# fetch_artifacts.py 的下载缓存（~391 MB 归档）
.artifacts_cache/

# 训练中间产物
checkpoints/
models/*.joblib
results/time_campaign/
.time_campaign_*.lock

# 特征文件可用 03_featurize.py / gnn_02_build_graphs.py 重新生成
data/processed/*.npz

# split 索引同样可再生：gnn_01_make_splits.py 秒级重建并校验，
# 且 npz 内是全宽 SMILES 数组（1.4-42 MB/个，7 个新靶点合计 ~212 MB）。
# 已 tracked 的 egfr/esol 旧副本不受影响。
data/processed/splits/*.npz
# Local recovery records and interrupted staging copies (never training inputs).
data/processed/splits/.*_time_regeneration.lock
data/processed/splits/.*_time_publication/
data/processed/splits/.*_time_last_publication.json*
data/processed/splits/.time-restore-*.tmp
data/processed/.time-regenerate-*/
.time-regenerate-*.tmp

# 系统垃圾
.DS_Store
release/
.scratch/

# Fetch recovery files survive failed rollback; inspect before manual recovery.
*.fetch_backup
